<?xml version="1.0"?>
<materialx version="1.39" colorspace="lin_rec709">
  <texcoord name="texcoord" type="vector2" />
  <image name="base_color_image" type="color3">
    <input name="file" type="filename" value="../textures/base_color.ppm" colorspace="srgb_texture" />
    <input name="texcoord" type="vector2" nodename="texcoord" />
  </image>
  <standard_surface name="surface" type="surfaceshader">
    <input name="base_color" type="color3" nodename="base_color_image" />
    <input name="specular_roughness" type="float" value="0.35" />
  </standard_surface>
  <surfacematerial name="WorkbenchMaterial" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="surface" />
  </surfacematerial>
</materialx>
